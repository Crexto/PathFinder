<Window x:Class="PathFinder.Views.GridEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PathFinder.Views"
        mc:Ignorable="d"
        Title="Grid Edit" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
           
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <UniformGrid x:Name="GridContainer" Grid.Row="0"/>
        <Button Click="BtnSave" HorizontalAlignment="Right" Grid.Row="1" Content="Save Changes" Width="100" Height="30" Margin="5,5,5,5"></Button>
        
    </Grid>
</Window>
