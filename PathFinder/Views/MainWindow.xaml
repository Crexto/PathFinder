<Window x:Class="PathFinder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PathFinder"
        mc:Ignorable="d"
        Title="PathFinder" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Label FontSize="24" Grid.ColumnSpan="2" Grid.Row="0" FontFamily="Segoe UI Semibold">PathFinder Application</Label>
        <Border Grid.Row="1" CornerRadius="10,10,10,10" BorderThickness="10,10,10,10" Background="#FFE4E4E4" Padding="10,0,10,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Label Margin="0,5,0,0" Grid.Row="0" FontSize="18" FontFamily="Segoe UI Semibold">1. Maze Adjustments</Label>
                <Label Margin="0,5,0,0" Grid.Row="1" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center">No. of Rows:</Label>
                <TextBox PreviewTextInput="NumberOnly" DataObject.Pasting="NumberOnlyPaste" Text="10" x:Name="TxtRows" Grid.Row="1" Grid.Column="1" Height="20" Width="100" HorizontalAlignment="Left"></TextBox>
                <Label Margin="0,5,0,0" Grid.Row="2" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center">No. of Columns:</Label>
                <TextBox PreviewTextInput="NumberOnly" DataObject.Pasting="NumberOnlyPaste" Text="10" x:Name="TxtColumns" Grid.Row="2" Grid.Column="1" Height="20" Width="100" HorizontalAlignment="Left"></TextBox>
                <StackPanel Margin="0,10,0,0" Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Custom" GroupName="MazeMode" IsChecked="True"/>
                    <RadioButton Content="Random" GroupName="MazeMode" Margin="50,0,0,0"/>
                </StackPanel>

                <Label Margin="0,5,0,10" Grid.Row="4" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center">Maze Generation Algorithm: </Label>
                <ComboBox SelectedIndex="0" Width="100" x:Name="CmbMazeAlgo" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ComboBoxItem>DFS</ComboBoxItem>
                    <ComboBoxItem>BFS</ComboBoxItem>
                    <ComboBoxItem>A*</ComboBoxItem>
                    <ComboBoxItem>Dijkstra</ComboBoxItem>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.ColumnSpan="2">
                    <Button Width="110" Height="26" Click="BtnResetMaze" Content="Reset Maze" Margin="5"/>
                    <Button Width="110" Height="26" Click="BtnEditMaze" Content="Edit Maze" Margin="5"/>
                    <Button Width="110" Height="26" IsEnabled="False" Content="Regenerate Maze" Margin="5"/>
                </StackPanel>



            </Grid>

        </Border>

        <Border Grid.Row="2" CornerRadius="10,10,10,10" BorderThickness="10,10,10,10" Background="#FFE4E4E4" Padding="10,0,10,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Margin="0,5,0,2" Grid.ColumnSpan="2" FontSize="18" FontFamily="Segoe UI Semibold">2. PathFinder Adjustments</Label>
                <Label Grid.Row="1" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center">Select Algorithm:</Label>

                <ComboBox SelectedIndex="0" Width="100" x:Name="CmbPathAlgo" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ComboBoxItem>DFS</ComboBoxItem>
                    <ComboBoxItem>BFS</ComboBoxItem>
                    <ComboBoxItem>A*</ComboBoxItem>
                    <ComboBoxItem>Dijkstra</ComboBoxItem>
                </ComboBox>

            </Grid>

        </Border>

        <Button Grid.Row="3" Click="BtnRun" Content="Run" Width="80" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"></Button>


    </Grid>
</Window>
