<Window x:Class="PathFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PathFinder"
        mc:Ignorable="d"
        Title="PathFinder" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <UniformGrid
            x:Name="GridContainer"
            Grid.Row="0"
            Rows="25"
            Columns="40"/>

        <Button Margin="0 0 10 0" Width="100" Grid.Row="1" x:Name="BtnRun" Content="Run" VerticalAlignment="Center" HorizontalAlignment="Right"></Button>
        <ComboBox Margin="0 0 120 0" Width="100" x:Name="CmbAlgo" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <ComboBoxItem>BFS</ComboBoxItem>
            <ComboBoxItem>DFS</ComboBoxItem>
            <ComboBoxItem>A*</ComboBoxItem>
            <ComboBoxItem>Djistra</ComboBoxItem>
        </ComboBox>

    </Grid>
</Window>
